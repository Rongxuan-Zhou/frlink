# franka-two-host client configuration.
#
#   cp config.env.example config.env    # then edit; config.env is local to this PC and not committed
#
# Every script under bin/ derives the repository root from its own location and sources
# <root>/config.env. The ${VAR:-default} form lets a value already present in your shell
# environment override the file (handy for one-off tests); leave it as is otherwise.

# --- the RT host ---------------------------------------------------------------------------
# IP of the RT host on the direct cable. The servo publishes its state to FRANKA_CLIENT_IP:50002
# and accepts targets on FRANKA_SERVO_HOST:50001 only from FRANKA_CLIENT_IP (docs/INTERFACE.md).
export FRANKA_SERVO_HOST=${FRANKA_SERVO_HOST:-10.10.0.2}

# Account on the RT host that owns franka-ctl. Your public key is appended to that account's
# ~/.ssh/authorized_keys with a forced command (rt-host/README.md, "Authorizing a new client key").
export FRANKA_CTL_USER=${FRANKA_CTL_USER:-rongxuan_zhou}

# Private ed25519 key used for the forced-command channel. install.sh creates it when missing.
export FRANKA_CTL_KEY=${FRANKA_CTL_KEY:-$HOME/.ssh/franka_ctl}

# Absolute path of franka-ctl on the host; only used to print the authorized_keys line.
export FRANKA_CTL_PATH=${FRANKA_CTL_PATH:-/home/$FRANKA_CTL_USER/franka/bin/franka-ctl}

# ssh alias written into ~/.ssh/config by install.sh (for interactive use: ssh <alias> status).
export FRANKA_CTL_SSH_ALIAS=${FRANKA_CTL_SSH_ALIAS:-alienware-rt}

# --- this PC -------------------------------------------------------------------------------
# Address of this PC on the direct cable. Must match FRANKA_CMD_ALLOW / FRANKA_STATE_DST in the
# host's /etc/franka/servo.env; the reference host is configured for 10.10.0.1 only.
export FRANKA_CLIENT_IP=${FRANKA_CLIENT_IP:-10.10.0.1}

# The NIC the cable is plugged into (ip -br link). install.sh prints the nmcli command that
# creates a "franka-link" profile with FRANKA_CLIENT_IP/24 on it.
export FRANKA_LINK_IFACE=${FRANKA_LINK_IFACE:-enp0s31f6}

# Python interpreter with requirements-teleop.txt installed (a venv or conda env). The state
# mirror itself only needs the system python3.
export FRANKA_PY=${FRANKA_PY:-python3}

# Optional: a URL the Quest can reach when it is not on the same network as this PC
# (e.g. a Tailscale Funnel in front of https://<this PC>:4443). Printed by the bridge only.
#export FRANKA_TELEOP_URL=https://my-pc.example.ts.net/

# Optional: override the teleop workspace box and mapping (defaults live in bin/franka-teleop).
#export FRANKA_WS_X_MIN=0.150 FRANKA_WS_X_MAX=0.700
#export FRANKA_WS_Y_MIN=-0.550 FRANKA_WS_Y_MAX=0.500
#export FRANKA_WS_Z_MIN=0.100 FRANKA_WS_Z_MAX=0.656
#export FRANKA_SCALE_TRANS=1.0 FRANKA_SCALE_ROT=0.5 FRANKA_MAX_STEP=0.0055
