# Overrides for franka-servo@.service. Production values (rog launch_pusht.sh:85 / launch_live.sh:39).
FRANKA_IMAGE=franka-rt:0.17.0-jazzy
FRANKA_ROBOT_IP=172.16.0.2
FRANKA_CMD_BIND=10.10.0.2
FRANKA_CMD_ALLOW=10.10.0.1
